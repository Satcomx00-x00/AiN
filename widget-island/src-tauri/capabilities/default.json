{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the island window may call: events, one entry per backend plugin, settings (read, and write for plugins that remember choices).",
  "windows": [
    "widget"
  ],
  "permissions": [
    "core:event:default",
    "island:default",
    "stats:default",
    "clipboard:default",
    "media:default",
    "volume:default",
    "privacy:default",
    "dictation:default",
    "settings:allow-get",
    "settings:allow-open",
    "popup:allow-bind",
    "settings:allow-set"
  ]
}
