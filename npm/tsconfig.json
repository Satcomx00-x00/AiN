{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["bun"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    // The launcher ships as plain JS (Node runs it as is), checked through its JSDoc.
    "allowJs": true,
    "checkJs": true
  },
  "include": ["build.ts", "ain/bin"]
}
