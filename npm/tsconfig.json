{
  // The npm packages are plain JS (npm runs them as published), checked through their JSDoc:
  // cd ain && bunx tsc -p ../npm
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "typeRoots": ["../ain/node_modules/@types"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["**/*.js", "**/*.mjs"]
}
