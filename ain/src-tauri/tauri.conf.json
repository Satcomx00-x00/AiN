{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AiN",
  "identifier": "dev.satcom.ain",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "label": "widget",
        "width": 200,
        "height": 32,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "skipTaskbar": true,
        "focus": false,
        "visible": false
      }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJEREIxQjYzNjU5RTVBMTgKUldRWVdwNWxZeHZiTFR6ckFET0ZtT1lJWFBQME5LTkExY01EL0RtcnJGcWZaSkVsNEczMHdsWmQK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "A dynamic-island style widget bar for the desktop",
    "copyright": "Copyright (c) 2026 Satcom",
    "license": "MIT",
    "resources": {
      "resources/personaplex/moshi_personaplex-0.1.0-py3-none-any.whl": "personaplex/moshi_personaplex-0.1.0-py3-none-any.whl"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libgtk-layer-shell0"
        ]
      },
      "rpm": {
        "depends": [
          "gtk-layer-shell",
          "libayatana-appindicator-gtk3"
        ]
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
