{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the island window may call: events, every feature, settings (read, and write for plugins that remember choices), and the third-party plugins to load.",
  "windows": [
    "widget"
  ],
  "permissions": [
    "core:event:default",
    "island:default",
    "stats:default",
    "clipboard:default",
    "media:default",
    "volume:default",
    "privacy:default",
    "dictation:default",
    "settings:allow-get",
    "settings:allow-open",
    "settings:allow-set",
    "settings:allow-quit",
    "popup:allow-bind",
    "extensions:allow-list"
  ]
}
