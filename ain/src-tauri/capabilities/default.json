{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the island window may call: events, every feature, settings (read, and write for plugins that remember choices), the third-party plugins to load, their secrets, and signing them in to online accounts.",
  "windows": [
    "widget"
  ],
  "permissions": [
    "core:event:default",
    "island:default",
    "stats:default",
    "clipboard:default",
    "media:default",
    "volume:default",
    "privacy:default",
    "dictation:default",
    "tts:default",
    "transcript:default",
    "persona:default",
    "spelling:default",
    "settings:allow-get",
    "settings:allow-open",
    "settings:allow-set",
    "settings:allow-quit",
    "popup:allow-bind",
    "extensions:allow-list",
    "secrets:allow-get",
    "oauth:default"
  ]
}
